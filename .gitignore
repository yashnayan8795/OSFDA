# Data files — large binaries (local only, not tracked by Git)
# Hierarchical patterns cover the new data/ sub-directory structure
data/**/*.parquet
data/**/*.npy
data/**/*.mdb
data/**/*.zip

# data/processed/ — large outputs (CSV, JSON) are local only
# Exception: a few small result files are intentionally tracked (see negations below)
data/processed/*.csv
data/processed/**/*.csv
data/processed/*.json
data/processed/**/*.json

# data/metadata/ — intentionally tracked (small, useful for repo browsing)
# Do NOT add data/metadata/*.csv here

# Always track these specific result files (they are small and git-tracked)
!data/processed/emerging_risks.csv
!data/processed/factor_graph.json
!data/processed/optuna.db

# Always track data documentation
!data/README.md
!data/metadata/

# Model files (large binary files)
models/*.pkl
models/*.txt
models/*.onnx
models/*.joblib
models/*.cbm
models/bertopic_model

# CatBoost logs
catboost_info/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
PYTHON_ARGCOMPLETE_OK

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

